# systemd user unit for coach/coach.py, on the host where Claude Code is signed in. Install:
#   ln -s "$PWD/coach/money-coach-chat.service" ~/.config/systemd/user/ && systemctl --user daemon-reload
#   systemctl --user enable --now money-coach-chat     (and `loginctl enable-linger` so it runs without a login)
# It reads the server's .env: MONEY_TOKEN, plus COACH_BIND set to an address the server container can reach
# (the docker bridge, e.g. 172.17.0.1) and MONEY_CHAT_URL=http://<that address>:8390 for the server.
[Unit]
Description=money-coach chat (Claude Code headless)
After=network-online.target

[Service]
WorkingDirectory=%h/Projects/money-coach
EnvironmentFile=%h/Projects/money-coach/.env
Environment=CLAUDE_BIN=%h/.local/bin/claude
ExecStart=/usr/bin/python3 coach/coach.py
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
